#!/usr/bin/env python3
"""Add Prefix — a starter command for Otto Files' command palette.

Copy this to ~/.config/otto/files-scripts/<name>, make it executable, open a
new Files window, and it appears in the palette (Ctrl+P) and the right-click
menu. Rename the file, the command `id` and the titles, then replace `plan`,
`preview` and `run` with what you actually want.

It shows every part of the protocol in one place: a described command with an
argument and a live preview, a preview that changes nothing, a run that reports
its changes so Undo works, and translated strings.

    ./starter describe
    ./starter preview < request.json
    ./starter run     < request.json
"""

import json
import os
import sys

# Every string a person reads, once per language. Files picks the window's
# language, then the bare language, then English.
STRINGS = {
    "en": {
        "title": "Add Prefix",
        "keywords": ["rename", "prefix", "batch"],
        "undo": "Add Prefix",
        "prompt": "Put in front of each name",
        "label": "prefix",
        "taken": "{count} name(s) already taken",
        "conflict": "“{name}” is already there",
        "done": "Renamed {count} item(s)",
    },
    "it": {
        "title": "Aggiungi prefisso",
        "keywords": ["rinomina", "prefisso"],
        "undo": "Aggiungi prefisso",
        "prompt": "Da mettere davanti a ogni nome",
        "label": "prefisso",
        "taken": "{count} nome/i già in uso",
        "conflict": "“{name}” esiste già",
        "done": "Rinominati {count} elementi",
    },
}


def strings(locale):
    """The table for `locale`, falling back the way Files does."""
    tag = (locale or "en").replace("_", "-").lower()
    for candidate in (tag, tag.split("-")[0], "en"):
        for key, table in STRINGS.items():
            if key.lower() == candidate:
                return table
    return STRINGS["en"]


def by_locale(key):
    """One field, keyed by language, as `describe` wants it."""
    return {tag: table[key] for tag, table in STRINGS.items()}


def describe():
    return {
        "commands": [
            {
                "id": "add-prefix",
                "title": by_locale("title"),
                "keywords": by_locale("keywords"),
                "group": "file",
                "undo": by_locale("undo"),
                # Offered only when there is something to act on.
                "when": {"targets": "some", "kinds": "any"},
                # Ask for text first, and preview while it is typed.
                "arg": {
                    "prompt": by_locale("prompt"),
                    "label": by_locale("label"),
                    "placeholder": "2026-",
                    "preview": True,
                },
            }
        ]
    }


def plan(request):
    """One (source, destination) per target. The single source of truth: the
    preview and the run must never disagree about what would happen."""
    prefix = request.get("arg") or ""
    pairs = []
    for source in request["targets"]:
        folder, name = os.path.split(source)
        pairs.append((source, os.path.join(folder, prefix + name)))
    return pairs


def preview(request):
    """A dry run. It must change nothing, and it has 0.6 seconds."""
    rows = []
    for source, destination in plan(request):
        rows.append(
            {
                # `from` has to be the target's own file name: that is how
                # Files finds the row again when someone skips it.
                "from": os.path.basename(source),
                "to": os.path.basename(destination),
                "conflict": source != destination and os.path.exists(destination),
            }
        )
    table = strings(request.get("locale") or os.environ.get("OTTO_LOCALE"))
    taken = sum(row["conflict"] for row in rows)
    note = table["taken"].format(count=taken) if taken else None
    return {"rows": rows, "note": note}


def run(request):
    """Do the work, and say what changed so Undo can reverse it."""
    table = strings(request.get("locale") or os.environ.get("OTTO_LOCALE"))
    pairs = [(s, d) for s, d in plan(request) if s != d]

    # Check everything before touching anything. Files records changes only
    # from a reply, so a run that fails half way leaves work no Undo can
    # reverse — refuse first instead. A non-zero exit is the failure, and the
    # last line on stderr is what the person reads.
    for _, destination in pairs:
        if os.path.exists(destination):
            sys.exit(table["conflict"].format(name=os.path.basename(destination)))

    changes = []
    for source, destination in pairs:
        os.rename(source, destination)
        changes.append({"kind": "moved", "from": source, "to": destination})
    return {
        "status": table["done"].format(count=len(changes)),
        "changes": changes,
        "reload": True,
    }


def main():
    verb = sys.argv[1] if len(sys.argv) > 1 else ""
    if verb == "describe":
        out = describe()
    elif verb == "preview":
        out = preview(json.load(sys.stdin))
    elif verb == "run":
        out = run(json.load(sys.stdin))
    else:
        sys.exit(f"usage: {os.path.basename(sys.argv[0])} describe|preview|run")
    json.dump(out, sys.stdout)


if __name__ == "__main__":
    main()
