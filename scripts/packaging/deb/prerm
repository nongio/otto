#!/bin/sh
set -e
# Remove the default icon theme's symlinks while their lists are still
# installed — on upgrade too, so that the incoming package never writes a
# file through one and a downgrade to a package without these scripts does
# not inherit them dangling. postinst makes them again. See
# resources/icon-theme-links.
case "$1" in
    remove|upgrade|deconfigure|failed-upgrade)
        /usr/lib/otto/icon-theme-links remove
        ;;
esac
