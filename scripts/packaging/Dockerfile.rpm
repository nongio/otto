# Install the built .rpm on a clean Fedora image and check the result.
#
# A successful `docker build` is a passing test: every declared Requires is
# checked to exist, dnf resolves them against the real repositories, then
# verify-install.sh asserts the installed layout. Build from the repo root
# with the .rpm already in target/generate-rpm:
#
#   docker build -f scripts/packaging/Dockerfile.rpm .
#
# An .rpm in target/generate-rpm-before is installed first, and the one
# under test then has to *upgrade* it: that is how a nightly is checked
# against the release it was built from. `dnf install` of a local file that
# is not newer than what is installed exits 0 having done nothing, so the
# installed version is compared to the package under test afterwards.
ARG BASE=fedora:41
FROM ${BASE}

ARG SKIP_RUN=0

# The Fedora image sets tsflags=nodocs to stay small, which throws away
# every %doc file on install — the README, the licence and
# portals.conf.example. Left in place the check below blames the package
# for the image's diet, the same trap as dpkg's excludes on the Debian
# images and NoExtract on the Arch one.
RUN sed -i '/^tsflags=nodocs/d' /etc/dnf/dnf.conf
RUN dnf install -y desktop-file-utils && dnf clean all

COPY target/generate-rpm/ /tmp/pkg/
COPY target/generate-rpm-before/ /tmp/before/
COPY scripts/packaging/verify-install.sh /usr/local/bin/verify-install.sh

# Every *named* Requires must exist in the repositories. Checked separately
# from the install because it is the half that is about the packaging:
# `wayland` is the source package on Fedora, not a binary one, and naming it
# makes the package uninstallable for every user. The parenthesised entries
# are cargo-generate-rpm's auto-generated symbol dependencies
# (libm.so.6(GLIBC_2.44) and friends) — those describe the build machine's
# glibc rather than the metadata, so they are excluded here.
RUN set -eux; \
    rpm -qp --requires /tmp/pkg/*.rpm \
        | awk '{print $1}' | grep -v '(' | grep -v '^rpmlib' | sort -u > /tmp/requires.txt; \
    cat /tmp/requires.txt; \
    fail=0; \
    while read -r r; do \
        case "$r" in \
            # A path is a file requirement, satisfied by whichever package
            # owns it, so it is resolved with `provides` rather than by name.
            /*) dnf -q provides "$r" >/dev/null 2>&1 \
                    || { echo "NO SUCH FILE PROVIDER: $r"; fail=1; };; \
            *)  dnf -q list --available "$r" >/dev/null 2>&1 \
                    || dnf -q list --installed "$r" >/dev/null 2>&1 \
                    || { echo "NO SUCH PACKAGE: $r"; fail=1; };; \
        esac; \
    done < /tmp/requires.txt; \
    [ "$fail" = 0 ]

# The package being upgraded from, when there is one. The same two paths as
# the install below: strict through dnf for a CI-built package, --nodeps
# for a local one.
RUN if ls /tmp/before/*.rpm >/dev/null 2>&1; then \
        if [ "$SKIP_RUN" = "1" ]; then \
            rpm -Uvh --nodeps /tmp/before/*.rpm; \
        else \
            dnf install -y /tmp/before/*.rpm && dnf clean all; \
        fi; \
        echo "before: $(rpm -q --qf '%{EVR}' otto)"; \
    fi

# `dnf install` rather than `rpm -i`, so unsatisfied Requires fail here the
# way they would for a user. A locally built package cannot pass that: its
# binaries carry the build machine's glibc symbol versions, which Fedora
# genuinely does not provide, so it is installed --nodeps to reach the layout
# check. The name check above still ran; the release package still takes the
# strict path.
RUN if [ "$SKIP_RUN" = "1" ]; then \
        rpm -Uvh --nodeps /tmp/pkg/*.rpm; \
    else \
        dnf install -y /tmp/pkg/*.rpm && dnf clean all; \
    fi

# What is installed has to be the package under test. With a "before"
# package this is the upgrade check: dnf keeps a newer or equal version
# and exits 0, so the version is the only evidence.
RUN set -eu; \
    want=$(rpm -qp --qf '%{EVR}' /tmp/pkg/*.rpm); \
    have=$(rpm -q --qf '%{EVR}' otto); \
    echo "installed: $have"; \
    [ "$have" = "$want" ] || { echo "expected $want to be installed"; exit 1; }; \
    if ls /tmp/before/*.rpm >/dev/null 2>&1; then \
        before=$(rpm -qp --qf '%{EVR}' /tmp/before/*.rpm); \
        [ "$before" != "$want" ] || { echo "before and after are the same version"; exit 1; }; \
        echo "upgraded: $before -> $want"; \
    fi

RUN OTTO_SKIP_RUN=$SKIP_RUN bash /usr/local/bin/verify-install.sh rpm

RUN rpm -e --nodeps otto && echo "remove ok"
