target
Cargo.lock
# The workspace lock is tracked on purpose: Otto is an application, not a
# library, and an unpinned CI resolves fresh dependencies on every run — a
# patch release upstream then changes the build with no commit behind it.
!/Cargo.lock
*.bk
*.log
.vscode
.vagga
resources/backgrounds/*
otto_config.toml
otto_config.*.toml

wlcs/

# Product docs inbox (scratch space, not committed)
docs/inbox/

# Code investigations (scratch space, not committed)
docs/investigations/

# makepkg artifacts
# Running makepkg in-tree extracts the source tarball into ./src, which
# collides with the crate's own src/. Anchored and hyphen-specific so the
# tracked src/otto_dock/ is not caught.
/src/otto/
/src/otto-*/
pkg/
*.pkg.tar.zst
*.pkg.tar.xz
*.tar.gz
*.tar.xz
*.tar.zst
specs/tmp/

# Perf scratch — raw profiler data (large binary, not committed)
perf.data
perf.data.old
*.skp
perf/**/perf.data
perf/**/perf.data.old

# Screen recordings and scene dumps from debugging sessions
rec.mp4
scene.json
